# Serves the playground and proxies the API on the same origin.
#   FIRECRAWL_UPSTREAM  host:port of the Firecrawl API (default api:3002)
#   LISTEN_PORT         port to listen on (default 8080)
{
	# Plain HTTP only (TLS terminates in front, e.g. Traefik), no admin API,
	# nothing written to /config at runtime.
	admin off
	auto_https off
	persist_config off
}

:{$LISTEN_PORT:8080} {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src * data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	# Liveness/readiness probe, answered by Caddy itself.
	handle /healthz {
		respond "ok" 200
	}
	handle /v1/* {
		reverse_proxy {$FIRECRAWL_UPSTREAM:api:3002}
	}
	handle /v2/* {
		reverse_proxy {$FIRECRAWL_UPSTREAM:api:3002}
	}
	handle {
		root * /srv
		file_server
	}
}
